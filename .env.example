# Copiar para .env (cp .env.example .env) e alterar os valores antes de partilhar o ambiente.
# As palavras-passe entram em URLs de ligação: usar apenas letras, números e hífenes.

# Porto do host onde o gateway fica publicado
GATEWAY_PORT=8080

# JWT (emitido por users, validado localmente em cada serviço)
# Gerar um segredo próprio com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Base de dados de users
USERS_DB_NAME=users
USERS_DB_USER=users
USERS_DB_PASSWORD=troque-esta-palavra-passe-users

# Base de dados de catalog
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=troque-esta-palavra-passe-catalog

# Base de dados de orders
ORDERS_DB_NAME=orders
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=troque-esta-palavra-passe-orders

# Base de dados de payments
PAYMENTS_DB_NAME=payments
PAYMENTS_DB_USER=payments
PAYMENTS_DB_PASSWORD=troque-esta-palavra-passe-payments
